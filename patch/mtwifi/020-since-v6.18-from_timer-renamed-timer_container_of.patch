+#ifdef timer_container_of
+#define MTK_TIMER_CONTAINER_OF(_var, _timer, _field) \
+	timer_container_of(_var, _timer, _field)
+#else
+#define MTK_TIMER_CONTAINER_OF(_var, _timer, _field) \
+	from_timer(_var, _timer, _field)
+#endif
+
